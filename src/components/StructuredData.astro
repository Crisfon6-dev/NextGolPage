---
/**
 * JSON-LD structured data (schema.org) — the machine-readable layer that lets
 * Google build rich results and lets LLMs (Claude, Perplexity, ChatGPT) extract
 * NextGol as an entity with concrete facts. Localized per page.
 */
import { CONFIG, waLink, type Lang } from "../config";
import { copy } from "../content/copy";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = copy[lang];
const site = CONFIG.SITE_URL;
const pageUrl = new URL(path, site).toString();
const logo = new URL("/logo-mark-512.png", site).toString();
const ogImage = new URL("/og-image.png", site).toString();

const orgId = `${site}/#organization`;
const siteId = `${site}/#website`;
const slogan = "ChatGPT te dice cómo hacerlo; un agente de IA lo hace por ti.";

const sameAs = [CONFIG.INSTAGRAM_URL, CONFIG.LINKEDIN_URL].filter(Boolean);

const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": orgId,
    name: "NextGol",
    url: site,
    logo: { "@type": "ImageObject", url: logo, width: 512, height: 512 },
    image: ogImage,
    description: t.meta.description,
    slogan,
    founder: {
      "@type": "Person",
      name: "Cristhian Fonseca",
      jobTitle: "Fundador",
      ...(CONFIG.LINKEDIN_URL ? { sameAs: [CONFIG.LINKEDIN_URL] } : {}),
    },
    sameAs,
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "sales",
      url: waLink("direct"),
      availableLanguage: ["Spanish", "English"],
    },
    knowsLanguage: ["es", "en"],
    areaServed: ["US", "Latin America"],
    knowsAbout: ["agentes de IA", "inteligencia artificial para negocios"],
  },
  {
    "@type": "WebSite",
    "@id": siteId,
    url: site,
    name: "NextGol",
    inLanguage: lang,
    description: t.meta.description,
    publisher: { "@id": orgId },
  },
  {
    "@type": "ProfessionalService",
    "@id": `${site}/#service`,
    name: "NextGol",
    url: pageUrl,
    image: ogImage,
    description: t.meta.description,
    provider: { "@id": orgId },
    areaServed: ["US", "Latin America"],
    availableLanguage: ["Spanish", "English"],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Servicios de NextGol",
      itemListElement: [
        {
          "@type": "Service",
          name: "Agentes de IA para negocios",
          provider: { "@id": orgId },
          hasOfferCatalog: {
            "@type": "OfferCatalog",
            name: "Cómo empezar",
            itemListElement: [
              {
                "@type": "Offer",
                name: t.offer.title,
                description: "Videollamada de 30 minutos y, en 48 horas, una página hecha para tu negocio: qué automatizar primero, cómo se resolvería y cuánto cuesta.",
                // No price on purpose: the Mapa is free, but price 0 needs a currency.
              },
            ],
          },
        },
      ],
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    inLanguage: lang,
    mainEntity: t.faq.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];

// Secondary pages (e.g. /privacidad) only carry the entity graph; service + FAQ belong to the landing.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": path === "/" ? graph : graph.slice(0, 2),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
