---
/**
 * Persistent conversion affordances (BJ Fogg: the Prompt must always be present).
 * - Mobile: a sticky bottom bar with the primary CTA (WhatsApp MAPA) — thumb-
 *   reachable, revealed after the user scrolls past the hero.
 * - Desktop: a floating WhatsApp button with the same link.
 * Both use the SSR TopConnect message; interactions.ts rewrites it per utm_source.
 */
import { LINKS, type Lang } from "../config";
import { copy } from "../content/copy";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<!-- Mobile sticky conversion bar (revealed after hero scroll) -->
<div class="ng-convbar" data-conv-bar>
  <a href={LINKS.whatsapp} target="_blank" rel="noopener noreferrer" class="ng-btn ng-btn-primary ng-convbar-cta" data-cta="whatsapp" data-cta-location="sticky">
    <Icon name="whatsapp" size={18} stroke={2} />
    <span>{t.hero.ctaPrimary}</span>
  </a>
</div>

<!-- Desktop floating WhatsApp button -->
<a
  href={LINKS.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  class="ng-wa-fab"
  data-conv-fab
  data-cta="whatsapp"
  data-cta-location="fab"
  aria-label={t.hero.ctaPrimary}
>
  <Icon name="whatsapp" size={26} stroke={2} />
</a>
