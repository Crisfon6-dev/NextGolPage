---
/**
 * Single source of page composition. Phase 1 is Spanish-only; `lang` is kept so
 * the phase-2 English change only has to supply translated copy.
 * Order: Nav, Hero, Cómo funciona, Mapa, Casos, Fundador, FAQ, CTA final, Footer.
 */
import { type Lang } from "../config";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Process from "./Process.astro";
import Offer from "./Offer.astro";
import UseCases from "./UseCases.astro";
import Founder from "./Founder.astro";
import FAQ from "./FAQ.astro";
import FinalCTA from "./FinalCTA.astro";
import Footer from "./Footer.astro";
import ConvCTA from "./ConvCTA.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="main-content">
  <Hero lang={lang} />
  <Process lang={lang} />
  <Offer lang={lang} />
  <UseCases lang={lang} />
  <Founder lang={lang} />
  <FAQ lang={lang} />
  <FinalCTA lang={lang} />
</main>
<Footer lang={lang} />
<ConvCTA lang={lang} />

<script>
  import "../scripts/interactions";
</script>
