---
/**
 * Single source of page composition, parameterized by locale. Both routes
 * (`/` ES and `/en/` EN) render this with their `lang`, so every word is
 * server-rendered per language — fully visible to search engines and LLMs.
 */
import { type Lang } from "../config";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import TrustBar from "./TrustBar.astro";
import Services from "./Services.astro";
import ForWho from "./ForWho.astro";
import Differentiators from "./Differentiators.astro";
import Process from "./Process.astro";
import SocialProof from "./SocialProof.astro";
import FAQ from "./FAQ.astro";
import FinalCTA from "./FinalCTA.astro";
import Footer from "./Footer.astro";
import ConvCTA from "./ConvCTA.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Nav lang={lang} />
<main id="main-content">
  <Hero lang={lang} />
  <TrustBar lang={lang} />
  <Services lang={lang} />
  <ForWho lang={lang} />
  <Differentiators lang={lang} />
  <Process lang={lang} />
  <SocialProof lang={lang} />
  <FAQ lang={lang} />
  <FinalCTA lang={lang} />
</main>
<Footer lang={lang} />
<ConvCTA lang={lang} />

<script>
  import "../scripts/interactions";
</script>
