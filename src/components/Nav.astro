---
import { LINKS, type Lang } from "../config";
import { copy } from "../content/copy";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];

const links = [
  { href: "#servicios", label: t.nav.services },
  { href: "#paraquien", label: t.nav.who },
  { href: "#proceso", label: t.nav.process },
  { href: "#faq", label: t.nav.faq },
];

const homeLabel = lang === "es" ? "NextGol — inicio" : "NextGol — home";
const menuLabel = lang === "es" ? "Menú" : "Menu";
---

<nav
  data-nav
  style="position:sticky;top:0;z-index:50;background:rgba(10,14,20,.72);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid #161C25;"
>
  <div style="max-width:1180px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:18px;">
    <a href="#top" class="ng-logo" aria-label={homeLabel} style="display:flex;align-items:center;gap:10px;text-decoration:none;color:#F5F7FA;">
      <span style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#00E5A0,#3B82F6);color:#06120D;">
        <Icon name="logo" size={17} stroke={2.4} />
      </span>
      <span style="font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:-.01em;">Next<span style="color:#00E5A0;">Gol</span></span>
    </a>

    <div data-nav-desktop style="display:flex;align-items:center;gap:28px;">
      {links.map((l) => <a href={l.href} class="ng-navlink">{l.label}</a>)}
    </div>

    <div style="display:flex;align-items:center;gap:12px;">
      <div class="ng-lang-toggle" role="group" aria-label="Language">
        <a href="/" class="ng-lang-seg" data-lang-seg="es" hreflang="es" aria-label="Español" aria-current={lang === "es" ? "true" : undefined}>ES</a>
        <a href="/en/" class="ng-lang-seg" data-lang-seg="en" hreflang="en" aria-label="English" aria-current={lang === "en" ? "true" : undefined}>EN</a>
      </div>
      <a
        href={LINKS.booking}
        target="_blank"
        rel="noopener noreferrer"
        class="ng-btn ng-btn-primary ng-btn-sm"
      >{t.nav.cta}</a>
      <button
        type="button"
        data-nav-burger
        aria-label={menuLabel}
        aria-expanded="false"
        style="align-items:center;justify-content:center;width:44px;height:44px;background:transparent;border:1px solid #2A3340;border-radius:10px;color:#F5F7FA;cursor:pointer;"
      >
        <Icon name="menu" size={20} stroke={2} />
      </button>
    </div>
  </div>

  <div
    data-mobile-menu
    style="flex-direction:column;gap:4px;padding:8px 24px 18px;border-top:1px solid #161C25;background:rgba(10,14,20,.96);"
  >
    {links.map((l) => <a href={l.href} class="ng-mobile-link" data-menu-close>{l.label}</a>)}
  </div>
</nav>

<style>
  .ng-navlink {
    font-size: 14.5px;
    color: #a7b0be;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .ng-navlink:hover {
    color: #f5f7fa;
  }
  .ng-mobile-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 8px;
    font-size: 15px;
    color: #a7b0be;
    text-decoration: none;
    border-radius: 8px;
  }
  .ng-mobile-link:hover {
    color: #f5f7fa;
  }
</style>
