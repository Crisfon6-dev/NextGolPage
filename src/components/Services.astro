---
import { type Lang } from "../config";
import { copy } from "../content/copy";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];

const smallCards = [
  { key: "s2", icon: "cloud", col: 3, row: 1 },
  { key: "s3", icon: "puzzle", col: 4, row: 1 },
  { key: "s4", icon: "cap", col: 3, row: 2 },
  { key: "s5", icon: "users", col: 4, row: 2 },
] as const;
---

<section id="servicios" class="ng-section">
  <div class="ng-container">
    <div class="reveal ng-section-head">
      <div class="ng-eyebrow"><span class="ng-eyebrow-line"></span><span>{t.services.eyebrow}</span></div>
      <h2 class="ng-h2" style="margin-bottom:14px;">{t.services.title}</h2>
      <p style="margin:0;color:#A7B0BE;font-size:17px;line-height:1.6;">{t.services.subtitle}</p>
    </div>

    <div class="reveal" data-bento style="display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:minmax(150px,auto);gap:16px;">
      <!-- featured -->
      <div data-feat data-tilt="6" class="ng-tilt ng-feat-card" style="grid-column:1 / span 2;grid-row:1 / span 2;position:relative;background:linear-gradient(160deg,#12241F 0%,#11161F 55%);border:1px solid rgba(0,229,160,.28);border-radius:18px;padding:28px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.5),0 0 50px rgba(0,229,160,.14);">
        <div aria-hidden="true" style="position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:radial-gradient(circle,rgba(0,229,160,.25),transparent 70%);animation:ngGlow 6s ease-in-out infinite;"></div>
        <div style="display:flex;align-items:center;justify-content:space-between;position:relative;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#00E5A0,#3B82F6);color:#06120D;">
            <Icon name="ai" size={26} stroke={2} />
          </span>
          <span aria-hidden="true" style="font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#00E5A0;border:1px solid rgba(0,229,160,.4);border-radius:999px;padding:5px 11px;">★</span>
        </div>
        <div style="margin-top:auto;position:relative;">
          <h3 style="font-family:var(--font-display);font-weight:700;font-size:25px;margin:26px 0 10px;letter-spacing:-.01em;">{t.services.s1.title}</h3>
          <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#A7B0BE;max-width:360px;">{t.services.s1.desc}</p>
          <span style="display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:999px;background:rgba(0,229,160,.12);color:#3DF0B8;font-size:13px;font-weight:600;">
            <Icon name="check" size={15} stroke={2.4} />
            <span>{t.services.s1.benefit}</span>
          </span>
        </div>
      </div>

      <!-- small cards -->
      {smallCards.map((c) => (
        <div data-tilt="5" class="ng-tilt ng-svc-card" style={`grid-column:${c.col};grid-row:${c.row};background:#11161F;border:1px solid #1A212C;border-radius:16px;padding:22px;display:flex;flex-direction:column;justify-content:space-between;`}>
          <span style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:12px;background:rgba(0,229,160,.1);color:#00E5A0;">
            <Icon name={c.icon} size={20} stroke={1.7} />
          </span>
          <div>
            <h3 style="font-family:var(--font-display);font-weight:600;font-size:17px;margin:16px 0 4px;">{t.services[c.key].title}</h3>
            <p style="margin:0;font-size:13.5px;line-height:1.55;color:#A7B0BE;">{t.services[c.key].desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ng-feat-card:hover {
    box-shadow: 0 34px 90px rgba(0, 0, 0, 0.6), 0 0 80px rgba(0, 229, 160, 0.24);
  }
  .ng-svc-card:hover {
    border-color: rgba(0, 229, 160, 0.45);
    box-shadow: 0 20px 46px rgba(0, 0, 0, 0.5), 0 0 32px rgba(0, 229, 160, 0.13);
  }
</style>
