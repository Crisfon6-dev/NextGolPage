---
/**
 * Íconos SVG line (lucide-style, viewBox 24, round caps/joins, nunca filled).
 * Paths exactos del prototipo del handoff. El color se hereda del padre vía
 * currentColor; `stroke` y `size` son configurables porque el mismo ícono
 * aparece con distintos grosores/tamaños según la sección.
 */
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  stroke?: number;
  class?: string;
}

const ICONS = {
  logo: '<path d="M7.5 19V8"/><path d="M7.5 8 16.5 19"/><path d="M16.5 19V7"/><circle cx="16.5" cy="4" r="1.8" fill="currentColor" stroke="none"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  calendar: '<rect x="3" y="4" width="18" height="17" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  whatsapp: '<path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7A8.5 8.5 0 1 1 21 11.5Z"/>',
  check: '<path d="m6 12 4 4 8-9"/>',
  ai: '<path d="M12 3v3"/><rect x="4" y="6" width="16" height="12" rx="3"/><path d="M9 12h.01M15 12h.01M2 12v2M22 12v2"/>',
  cloud: '<path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97A6 6 0 0 0 6.34 9.4 4 4 0 0 0 7 17h10.5Z"/>',
  puzzle: '<path d="M9 2v6M15 2v6M9 8h6v3a3 3 0 0 1-3 3 3 3 0 0 1-3-3V8ZM12 14v8"/>',
  cap: '<path d="m22 9-10-5L2 9l10 5 10-5Z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  users: '<path d="M16 19a4 4 0 0 0-8 0M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM20 19a3 3 0 0 0-4-2.8M4 19a3 3 0 0 1 4-2.8"/>',
  code: '<path d="m18 16 4-4-4-4M6 8l-4 4 4 4M14.5 4l-5 16"/>',
  chart: '<path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/>',
  message: '<path d="M7 8h10M7 12h6M21 12c0 4-3.5 7-9 7-1.2 0-2.3-.1-3.3-.4L3 21l1.3-3.9A6.6 6.6 0 0 1 3 12c0-4 3.5-7 9-7s9 3 9 7Z"/>',
  shield: '<path d="M12 3 4 7v6c0 4.5 3.4 7.5 8 8 4.6-.5 8-3.5 8-8V7l-8-4Z"/><path d="m9 12 2 2 4-4"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
} as const;

const { name, size = 24, stroke = 2, class: className } = Astro.props;
const inner = ICONS[name] ?? "";
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={inner}
></svg>
