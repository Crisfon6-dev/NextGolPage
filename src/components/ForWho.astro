---
import { type Lang } from "../config";
import { copy } from "../content/copy";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section id="paraquien" class="ng-section ng-section--deep">
  <div class="ng-container">
    <div class="reveal ng-section-head">
      <div class="ng-eyebrow"><span class="ng-eyebrow-line"></span><span>{t.who.eyebrow}</span></div>
      <h2 class="ng-h2">{t.who.title}</h2>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px;">
      <!-- Lane A (brand) -->
      <div data-tilt="4" class="ng-tilt ng-lane ng-lane--a" style="background:#11161F;border:1px solid #1A212C;border-radius:18px;padding:30px;">
        <span style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#00E5A0;">{t.who.laneA.tag}</span>
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:12px 0 10px;letter-spacing:-.01em;">{t.who.laneA.title}</h3>
        <p style="margin:0 0 18px;font-size:15px;line-height:1.6;color:#A7B0BE;">{t.who.laneA.text}</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {t.who.laneA.bullets.map((b) => (
            <span class="ng-bullet">
              <Icon name="check" size={13} stroke={2.6} class="ng-bullet-icon-brand" />
              <span>{b}</span>
            </span>
          ))}
        </div>
      </div>

      <!-- Lane B (blue) -->
      <div data-tilt="4" class="ng-tilt ng-lane ng-lane--b" style="background:#11161F;border:1px solid #1A212C;border-radius:18px;padding:30px;">
        <span style="font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#7FB0FF;">{t.who.laneB.tag}</span>
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:12px 0 10px;letter-spacing:-.01em;">{t.who.laneB.title}</h3>
        <p style="margin:0 0 18px;font-size:15px;line-height:1.6;color:#A7B0BE;">{t.who.laneB.text}</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {t.who.laneB.bullets.map((b) => (
            <span class="ng-bullet">
              <Icon name="check" size={13} stroke={2.6} class="ng-bullet-icon-blue" />
              <span>{b}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ng-lane--a:hover {
    border-color: rgba(0, 229, 160, 0.4);
    box-shadow: 0 22px 52px rgba(0, 0, 0, 0.5), 0 0 38px rgba(0, 229, 160, 0.12);
  }
  .ng-lane--b:hover {
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 22px 52px rgba(0, 0, 0, 0.5), 0 0 38px rgba(59, 130, 246, 0.12);
  }
  .ng-bullet {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: #a7b0be;
    background: #0e141c;
    border: 1px solid #1a212c;
    border-radius: 8px;
    padding: 6px 11px;
  }
  .ng-bullet-icon-brand {
    color: #00e5a0;
  }
  .ng-bullet-icon-blue {
    color: #7fb0ff;
  }
</style>
