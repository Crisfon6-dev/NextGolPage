---
import { STACK, type Lang } from "../config";
import { copy } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section style="border-bottom:1px solid #14191F;background:#0C1118;">
  <div style="max-width:1180px;margin:0 auto;padding:30px 24px;display:flex;flex-direction:column;align-items:center;gap:18px;">
    <div style="font-size:12.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#A7B0BE;text-align:center;">{t.trust}</div>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px;">
      {STACK.map((tech) => (
        <span class="ng-stack-pill">{tech}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .ng-stack-pill {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #a7b0be;
    border: 1px solid #1a212c;
    background: #0e141c;
    border-radius: 8px;
    padding: 7px 13px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .ng-stack-pill:hover {
    border-color: rgba(0, 229, 160, 0.4);
    color: #f5f7fa;
  }
</style>
