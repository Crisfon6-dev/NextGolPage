---
import { LINKS, type Lang } from "../config";
import { copy } from "../content/copy";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];

const statLabel = lang === "es" ? "costos operativos" : "operating costs";
const integrationsLabel = lang === "es" ? "Integraciones" : "Integrations";
---

<header id="top" style="position:relative;overflow:hidden;border-bottom:1px solid #14191F;">
  <!-- background decorations -->
  <div
    aria-hidden="true"
    style="position:absolute;inset:0;background:radial-gradient(820px 420px at 12% -8%, rgba(0,229,160,.16), transparent 60%), radial-gradient(760px 480px at 96% 4%, rgba(59,130,246,.15), transparent 55%);pointer-events:none;animation:ngGlow 9s ease-in-out infinite;"
  >
  </div>
  <div
    aria-hidden="true"
    style="position:absolute;inset:0;background-image:linear-gradient(#10161f 1px, transparent 1px), linear-gradient(90deg, #10161f 1px, transparent 1px);background-size:46px 46px;opacity:.32;-webkit-mask-image:linear-gradient(180deg,#000 0%,transparent 72%);mask-image:linear-gradient(180deg,#000 0%,transparent 72%);pointer-events:none;"
  >
  </div>

  <div data-hero-grid style="position:relative;max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,96px) 24px clamp(64px,9vw,104px);display:grid;grid-template-columns:1.05fr 0.95fr;gap:48px;align-items:center;">
    <!-- text column -->
    <div style="animation:ngRevealUp .8s var(--ease-out) both;">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:24px;">
        <span style="font-family:var(--font-display);font-size:13px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:#00E5A0;">{t.hero.eyebrow}</span>
        <span style="display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid #1F2A38;border-radius:999px;background:rgba(17,22,31,.6);font-size:12.5px;color:#A7B0BE;">
          <span aria-hidden="true" style="width:7px;height:7px;border-radius:50%;background:#00E5A0;box-shadow:0 0 10px #00E5A0;animation:ngGlow 2.5s ease-in-out infinite;"></span>
          <span>{t.hero.badge}</span>
        </span>
      </div>

      <h1 style="font-family:var(--font-display);font-weight:700;font-size:clamp(36px,5.4vw,64px);line-height:1.04;letter-spacing:-.03em;margin:0;">
        {t.hero.pre}<span class="ng-accent">{t.hero.accent}</span>{t.hero.post}
      </h1>

      <p style="margin:22px 0 0;max-width:520px;font-size:clamp(16px,1.6vw,18px);line-height:1.6;color:#A7B0BE;">{t.hero.subhead}</p>

      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px;">
        <a href={LINKS.booking} target="_blank" rel="noopener noreferrer" class="ng-btn ng-btn-primary">
          <Icon name="calendar" size={18} stroke={2.2} />
          <span>{t.hero.ctaPrimary}</span>
        </a>
        <a href={LINKS.whatsapp} target="_blank" rel="noopener noreferrer" class="ng-btn ng-btn-ghost">
          <Icon name="whatsapp" size={18} stroke={2} />
          <span>{t.hero.ctaSecondary}</span>
        </a>
      </div>

      <div class="ng-cta-note" style="margin-top:14px;">
        <Icon name="check" size={14} stroke={2.6} />
        <span>{t.ctaNote}</span>
      </div>

      <div style="display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:26px;">
        {t.hero.micro.map((m) => (
          <span style="display:inline-flex;align-items:center;gap:7px;font-size:13px;color:#A7B0BE;">
            <Icon name="check" size={14} stroke={2.6} class="ng-check-brand" />
            <span>{m}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- hero visual (reflows below copy on mobile; never hidden) -->
    <div data-hero-visual style="position:relative;margin-inline:auto;width:100%;animation:ngRevealUp .9s var(--ease-out) .12s both;">
      <div aria-hidden="true" style="position:absolute;inset:-10% 5% 10% -5%;background:radial-gradient(circle at 60% 40%,rgba(0,229,160,.2),transparent 65%);filter:blur(20px);animation:ngGlow 7s ease-in-out infinite;pointer-events:none;"></div>
      <div style="position:relative;display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div data-tilt="8" class="ng-tilt" style="grid-column:1 / span 2;background:linear-gradient(160deg,#12241F,#11161F 60%);border:1px solid rgba(0,229,160,.28);border-radius:18px;padding:24px;box-shadow:0 24px 60px rgba(0,0,0,.5),0 0 50px rgba(0,229,160,.12);">
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:13px;background:linear-gradient(135deg,#00E5A0,#3B82F6);color:#06120D;">
              <Icon name="ai" size={24} stroke={2} />
            </span>
            <span style="font-family:var(--font-display);font-weight:700;font-size:26px;color:#00E5A0;">−40<span style="font-size:16px;color:#A7B0BE;">%</span></span>
          </div>
          <div style="font-family:var(--font-display);font-weight:600;font-size:17px;margin-top:16px;">{t.services.s1.title}</div>
          <div style="font-size:13px;color:#A7B0BE;margin-top:4px;">{statLabel}</div>
        </div>
        <div data-tilt="8" class="ng-tilt" style="background:#11161F;border:1px solid #1A212C;border-radius:16px;padding:18px;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:11px;background:rgba(0,229,160,.1);color:#00E5A0;">
            <Icon name="cloud" size={19} stroke={1.8} />
          </span>
          <div style="font-size:13.5px;font-weight:600;margin-top:12px;">Cloud · AWS</div>
        </div>
        <div data-tilt="8" class="ng-tilt" style="background:#11161F;border:1px solid #1A212C;border-radius:16px;padding:18px;">
          <span style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:11px;background:rgba(59,130,246,.12);color:#7FB0FF;">
            <Icon name="puzzle" size={19} stroke={1.8} />
          </span>
          <div style="font-size:13.5px;font-weight:600;margin-top:12px;">{integrationsLabel}</div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .ng-accent {
    background: linear-gradient(120deg, #00e5a0, #3b82f6, #00e5a0);
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: ngShimmer 6s linear infinite;
  }
  .ng-check-brand {
    color: #00e5a0;
  }
</style>
